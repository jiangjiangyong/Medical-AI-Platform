APP_NAME=医学影像辅助决策与健康随访平台
APP_ENV=development

# All paths below are relative to the project root so the example works on the
# remote GPU host as well as on a local checkout.
API_CREDENTIALS_FILE=./api_credentials.txt
DATABASE_URL=sqlite:///./storage/medical_imaging_platform.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720
STORAGE_DIR=./storage

# Real MedGemma profile. Set VISION_ADAPTER=mock only for an explicit demo.
VISION_ADAPTER=medgemma_local
VISION_MODEL_NAME=MedGemma-4B-local-adapter
VISION_MODEL_VERSION=google/medgemma-4b-it
VISION_MODEL_PATH=
VISION_DEVICE=auto
VISION_TASK=detection
VISION_VLM_BASE_URL=http://127.0.0.1:9000
VISION_VLM_API_PATH=/v1/analyze
VISION_VLM_TOKEN=
VISION_VLM_MODEL=google/medgemma-4b-it
VISION_VLM_TIMEOUT_SECONDS=60

# HF_TOKEN is read by backend/scripts/serve_medgemma.py, not committed here.
SERVICE_TIMEOUT_SECONDS=45
SERVICE_RETRY_ATTEMPTS=2
SERVICE_RETRY_BACKOFF_SECONDS=0.25
SERVICE_CIRCUIT_FAILURE_THRESHOLD=3
SERVICE_CIRCUIT_RECOVERY_SECONDS=30
PERFORMANCE_P95_BUDGET_MS=3000
PERFORMANCE_FAILURE_RATE_BUDGET=0.02
MLOPS_DRIFT_PSI_THRESHOLD=0.20
EMBEDDING_MAX_CHARS=280
EMBEDDING_CHUNK_OVERLAP=40
EMBEDDING_BATCH_SIZE=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
